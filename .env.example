# ORBIT environment configuration
# Tests never require these values.

# OpenRouter credentials (used by the OpenRouter provider)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Agent safety limits
MAX_REPLANS=3
MAX_PLAN_TASKS=7
LLM_TIMEOUT_S=30
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=2
LLM_BACKOFF_S=0.5
TOOL_TIMEOUT_S=10

# Workspace-scoped file tools (paths relative to the project root)
ORBIT_WORKSPACE=workspace
MAX_FILE_BYTES=1000000

# Web search (LangSearch provider, free plan). Leave WEB_SEARCH_PROVIDER=none
# - or leave LANGSEARCH_API_KEY empty - to keep the offline, keyless behavior.
# Supported: none, langsearch
#   WEB_SEARCH_PROVIDER=langsearch
#   LANGSEARCH_API_KEY=<LangSearch API key>       (never commit this)
#   WEB_SEARCH_ENDPOINT=                          (optional, override/testing)
WEB_SEARCH_PROVIDER=none
LANGSEARCH_API_KEY=
WEB_SEARCH_ENDPOINT=

LOG_LEVEL=INFO
